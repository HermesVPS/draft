# =============================================================================
# Outlook Draft Campaign Manager — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# DJANGO CORE
# ---------------------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True for local dev, False in production
DEBUG=True

# uv link mode (copy is the safe default for Docker/cross-device)
UV_LINK_MODE=copy

# Comma-separated host/domain list
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# MICROSOFT GRAPH (ENTRA) — server-side OAuth for Outlook draft creation
# ---------------------------------------------------------------------------
# Register an app in Azure Portal > Microsoft Entra ID > App registrations.
# Redirect URI (Web): https://yourdomain/microsoft/callback/
# API permissions > Microsoft Graph > Delegated: Mail.ReadWrite, Mail.ReadWrite.Shared
# Certificates & secrets > New client secret.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Space-separated OAuth scopes. Keep Mail.ReadWrite for own mailbox; add
# Mail.ReadWrite.Shared only if the unsubscribe sync reads a shared mailbox.
MS_GRAPH_SCOPES=openid profile email User.Read Mail.ReadWrite Mail.ReadWrite.Shared

# Fernet key used to encrypt Microsoft refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# SUPPRESSION / UNSUBSCRIBE SYNC (shared mailbox)
# ---------------------------------------------------------------------------
SUPPRESSION_MAILBOX=support@proactivetraining.com.au
SUPPRESSION_FOLDER=UNSUBSCRIBE

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Leave empty for SQLite (dev). Set a Postgres URL in production.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---------------------------------------------------------------------------
# MEDIA (uploaded contact lists, templates, attachments)
# ---------------------------------------------------------------------------
# Local filesystem for dev. Use django-storages + R2/S3 in production.

# ---------------------------------------------------------------------------
# EMAIL (allauth verification / password-reset emails)
# ---------------------------------------------------------------------------
# DEBUG=True uses the console backend automatically — no SMTP needed.
# For production (DEBUG=False), configure an SMTP relay (e.g. SendGrid):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
